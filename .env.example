# Dashboard Data Source
DASHBOARD_DATA_MODE=mock

# Optional future integrations (leave empty for now)
PUBLIC_ANALYTICS_ENDPOINT=
PUBLIC_SHOP_METRICS_ENDPOINT=
PUBLIC_SOCIAL_METRICS_ENDPOINT=

# Optional TikTok Live API tokens (legacy direct access tokens)
TIKTOK_DR_ACCESS_TOKEN=
TIKTOK_MRS_ACCESS_TOKEN=

# Preferred TikTok OAuth setup for durable live follower/video/like data
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_OAUTH_SCOPES=user.info.basic,video.list,video.upload
TIKTOK_TOKEN_STORE_PATH=
TIKTOK_DR_REFRESH_TOKEN=
TIKTOK_MRS_REFRESH_TOKEN=

# Optional monitoring toggles
ENABLE_LINK_HEALTH_CHECK=true
ENABLE_ACTIVITY_FEED_MOCK=true
